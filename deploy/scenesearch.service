# systemd unit so the stack survives a VM reboot.
#
# `restart: unless-stopped` in Compose handles a container crashing; it does not handle the host
# rebooting, which Oracle does for maintenance. Without this, the Live URL goes down at a moment
# nobody is watching — and the rubric asks it to stay up for at least seven days after Demo Day.
#
#   sudo cp deploy/scenesearch.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now scenesearch

[Unit]
Description=SceneSearch API
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# EDIT ON INSTALL: this must match the checkout on the box, and it is not the same everywhere.
# The live box runs from /home/hieuhau2903/P-057; the installed copy of scenesearch.service
# was corrected there by hand while this file was not, so a fresh `cp` from the repo would
# reintroduce the wrong path.
WorkingDirectory=/home/ubuntu/P-057
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.prod.yml up -d
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.prod.yml down
# The image is large and the first build pulls torch; do not let systemd give up on it.
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
