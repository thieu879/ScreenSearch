# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# SceneSearch uses gpt-4o-mini for one short call per search (natural language -> structured
# constraint). Everything else is deterministic arithmetic over precomputed artifacts.
MODEL_NAME=gpt-4o-mini

# ---- Database / Vector Store: NOT USED ----
# The corpus is 404 x 768 floats (1.2 MB), held in memory. A vector DB would add a service and a
# second copy of the data to do the same matmul more slowly. See experiments/M2_DESIGN.md §5 for
# where that stops being true (7.2M frames, not here). Left declared for the template's defaults.
#
# DATABASE_URL is read by NOTHING. Do not point the review store at it: the value shipped in the
# template is `postgresql://user:password@localhost:5432/dbname`, a placeholder meaning "no database
# configured", and an earlier version of the review store that trusted it 500'd on every verdict.
# DATABASE_URL=sqlite:///./data/app.db
# CHROMA_PERSIST_DIR=./data/chroma

# ---- Human review (Brief §Chức năng chính) ----
# Where reviewer verdicts are buffered, as a plain sqlite file path. A working buffer, not the
# deliverable — the CSV/JSON export is. On a host with an ephemeral filesystem a restart loses it,
# so reviewers export before finishing a session (docs/api-contract.md).
# REVIEW_DB=data/reviews.db

# ---- SceneSearch artifacts ----
# Written by scripts/promote_artifacts.py. Committed, so these defaults work from a fresh clone.
ARTIFACTS_DIR=data/artifacts
THUMBS_DIR=data/thumbs

# ---- Operator access and abuse limits (src/api/security.py, src/api/ratelimit.py) ----
# The deployed URL is public. That is what the rate limits below defend against.
#
# OPERATOR_TOKEN used to live here, gating the review export and the whole-table summary with a
# shared secret pasted into the URL as `?operator_token=…`. **Retired 2026-08-27** — those two
# endpoints now require a signed-in user from the real login — any account, no role — which is
# revocable and attributable where one shared string is neither. Nothing reads the variable any more, so a box whose `.env`
# still sets it needs no edit: pydantic-settings ignores keys it does not declare.
#
# What the gate protects is unchanged and worth restating: `decision=all` returns every
# (query, frame_id, reviewer) triple, which is exactly what DELETE /reviews needs, so gating the
# export is also what closes mass deletion. See src/api/security.py.

# Believe X-Forwarded-For. True ONLY behind a trusted proxy — the deployed stack, where Caddy is the
# sole ingress and the API publishes no port. False for `make run` and for a tunnel, where the
# header is whatever the client typed. Wrong either way breaks the rate limiter: false behind Caddy
# puts every visitor in one bucket, true without a proxy lets anyone mint a new identity per request.
# TRUST_PROXY_HEADERS=false

# /search and /chat buy a gpt-4o-mini completion per call. The per-client limit stops one visitor
# hammering the box; the daily cap is what protects the bill, because a per-client limit multiplies
# by however many clients an attacker cares to be.
# LLM_RATE_LIMIT_PER_MINUTE=10
# LLM_DAILY_CAP=500
# WRITE_RATE_LIMIT_PER_MINUTE=60

# ---- Rejection band (experiments/M2_DESIGN.md §6.1-6.2) ----
# Two thresholds, not one. Below TAU_REJECT the archive is reported as not containing the query;
# between the two, results are returned WITH a low-confidence caveat; above TAU_CONFIDENT they are
# returned plainly. A single cutoff hid ~26% of legitimate searches, and a wrongly hidden result is
# the one error a user cannot detect.
#
# These are the values RE-FIT on 2026-08-02 for the 170-scene / 6,858-frame corpus, and they must
# stay equal to the defaults in `src/config.py`. The file previously shipped 0.35 / 0.457 — the band
# fitted to nuScenes-mini, retired because it does not transfer — so anyone who copied this file to
# `.env` silently overrode the fitted band with the old one and got q21 "a pedestrian to the
# front-left" refused at 0.330: a real query, and the one the metadata filter most improves.
TAU_REJECT=0.30
TAU_CONFIDENT=0.50
# Frames caption-checked for rejection. Larger is WORSE: the score is a max over k, so a bigger k
# gives an empty query more chances to hit one spuriously agreeable caption. 5 beats 10 and 20.
VERIFY_TOP_K=5

# ---- Diversity (experiments/M2_DESIGN.md §7) ----
# Max frames from one clip in the displayed head. At 2 Hz, consecutive keyframes are near-identical.
DIVERSITY_CAP=2

# Results per search when the caller does not ask for a number. This is ALSO the diversity window,
# so it is a retrieval parameter, not a page size: at cap 2, relational lift is +0.113 at 10 and
# +0.077 at 50, and distinct-scenes@10 is 5.50 either way. Raising it buys a longer page and costs
# precision. Every figure in eval/results/ was measured at 10.
DEFAULT_TOP_K=10

# ---- App Config ----
APP_ENV=development

# Which build is running, reported by /health and shown in the sidebar. Do NOT set it here for a
# deployment: the image bakes it from Dockerfile's RELEASE build arg, because `.git` is
# dockerignored and a container cannot ask git. Set it only to override locally.
#   RELEASE=$(git describe --tags) docker compose -f deploy/docker-compose.prod.yml up -d --build
# RELEASE=
APP_PORT=8000
APP_HOST=0.0.0.0
# The deployed frontend origin MUST be listed here or every browser request fails — and it fails
# looking like a backend outage rather than a config problem. Add Vercel preview origins too.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Deployment only (deploy/docker-compose.prod.yml) ----
# Hostname Caddy obtains a TLS certificate for. A bare IP cannot have one, and without TLS an
# HTTPS frontend cannot call this backend at all. See docs/deploy.md.
# DOMAIN=your-name.duckdns.org

# ---- LangSmith (AI Logs — Deliverable #4) ----
# Read via src/config.py, which sets the LANGCHAIN_* variables LangChain itself reads. Off by
# default so a local run never silently ships queries to a hosted service.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=scenesearch

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Authentication (JWT) ----
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production-use-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ------ Database -----
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Google OAuth 2.0 Credentials
# 1. Cấu hình CORS (Cho phép cả Localhost và DuckDNS)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://scenesearch.duckdns.org

# 2. Google OAuth Credentials
#
# **Hai biến này được đọc ở hai thời điểm khác nhau — đó là lý do Google sign-in hỏng trên mọi bản
# deploy cho tới v1.7.** GOOGLE_* là biến RUNTIME của backend: sửa .env trên máy chủ rồi
# `up -d --force-recreate api` là đủ. VITE_* là biến BUILD-TIME: `vite build` thay nó thành hằng số
# trong bundle, nên một image đã build mà thiếu nó thì KHÔNG BAO GIỜ lấy được từ .env của máy chủ —
# phải build lại. Xem stage `frontend` trong Dockerfile.
#
# Client id KHÔNG phải bí mật (nó nằm công khai trong bundle). Client secret thì có, và nó chỉ ở
# phía backend, không bao giờ đi vào bundle.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Cùng giá trị với GOOGLE_CLIENT_ID. Để trống là hợp lệ: khi đó frontend ẨN nút Google thay vì hiện
# một nút bấm vào không chạy được.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# 3. Để trống VITE_GOOGLE_REDIRECT_URI để Frontend tự lấy URL động theo trình duyệt!
# Redirect URI phải được khai báo trong Google Cloud Console, ví dụ:
#   https://scenesearch.duckdns.org/auth/google/callback
# VITE_GOOGLE_REDIRECT_URI=

# ---- Gmail SMTP Email Settings ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ---- Redis Storage Settings ----
REDIS_URL=redis://localhost:6379/0

